# 3rdparty bundled libraries (generated by CI/CD)
3rdparty/

# Downloaded, checksum-pinned, never committed: the ML models, and the
# reference portraits the recognition test runs against (a face recognition
# project has no business carrying photos of people in its history)
python/models/*.onnx
tests/fixtures/faces/

# Clip music: fetched by media/download_tracks.sh, pinned by checksum. The
# beat grids beside it (media/*.json) are committed, so what the composer
# cuts on stays reviewable even though the audio is not.
media/*.ogg
media/*.opus
media/*.mp3
media/*.m4a

