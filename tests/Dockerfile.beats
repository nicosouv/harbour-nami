# Beat analysis, run once per track and never on a device.
#
# librosa and its stack are large and have nothing to do with the app: the
# whole point of analysing here is that the phone reads a JSON file instead.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg \
      libsndfile1 \
      curl \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir librosa==0.10.2.post1 numpy soundfile
